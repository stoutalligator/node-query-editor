{
  "name": "node-extract-app",
  "version": "0.1.0",
  "description": "XML/JSON query workbench — XPath/JSONPath SQL-like editor for large files",
  "main": "dist/main.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "start": "npm run compile && electron .",
    "dev": "node esbuild.js --watch & electron . --dev",
    "package": "npm run compile && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "ag-grid-community": "^35.3.0",
    "domhandler": "^5.0.3",
    "htmlparser2": "^9.1.0",
    "monaco-editor": "^0.55.1"
  },
  "build": {
    "appId": "com.stout-alligator.node-extract-app",
    "productName": "Node Extract",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
